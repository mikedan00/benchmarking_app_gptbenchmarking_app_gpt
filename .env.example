# ─────────────────────────────────────────────────────────────────────────────
# AI 벤치마킹 보고서 시스템  ·  환경변수 설정 파일
# 복사 후 .env 로 이름 변경:  cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# [필수] HuggingFace API 토큰
# 발급: https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# [선택] 사용할 LLM 모델 ID (기본값: google/gemma-4-26B-A4B-it)
# 대안: mistralai/Mixtral-8x7B-Instruct-v0.1 / meta-llama/Llama-3.1-8B-Instruct
# HF_MODEL_ID=google/gemma-4-26B-A4B-it
# HF_PROVIDER=auto

# [선택] Streamlit 서버 설정
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_MAX_UPLOAD_SIZE=200
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
STREAMLIT_SERVER_HEADLESS=true

# [선택] 기업 프록시 환경
# HTTP_PROXY=http://proxy.company.com:8080
# HTTPS_PROXY=http://proxy.company.com:8080
